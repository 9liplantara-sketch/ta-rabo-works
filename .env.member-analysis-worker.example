# Local Worker 用 env（値は各自設定。本ファイルを .env.member-analysis-worker にコピー）
MEMBER_ANALYSIS_WORKER_BASE_URL=https://ta-rabo-works.vercel.app
MEMBER_ANALYSIS_WORKER_SECRET=
MEMBER_ANALYSIS_WORKER_ID=local-mac-studio
MEMBER_ANALYSIS_WORKER_POLL_MS=45000
MEMBER_ANALYSIS_WORKER_HEARTBEAT_MS=60000
MEMBER_ANALYSIS_OLLAMA_URL=http://127.0.0.1:11434
MEMBER_ANALYSIS_OLLAMA_MODEL=qwen3.6:35b-a3b
MEMBER_ANALYSIS_OLLAMA_TEMPERATURE=0.1
MEMBER_ANALYSIS_OLLAMA_NUM_CTX=16384
MEMBER_ANALYSIS_OLLAMA_PRESENCE_PENALTY=0
MEMBER_ANALYSIS_OLLAMA_KEEP_ALIVE=10m
MEMBER_ANALYSIS_OLLAMA_TIMEOUT_MS=600000
